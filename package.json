{
  "name": "simple-skill-manager",
  "version": "0.1.1",
  "description": "Local web app that gathers the skills scattered across your AI coding agents (Claude Code, Codex, Gemini CLI, …) into one deduplicated library, with per-agent enable/disable, MCP overview, marketplace and GitHub sync.",
  "keywords": [
    "skills",
    "agent",
    "claude-code",
    "codex",
    "gemini-cli",
    "mcp",
    "skill-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliZe198/simple-skill-manager.git"
  },
  "homepage": "https://github.com/AliZe198/simple-skill-manager#readme",
  "bugs": {
    "url": "https://github.com/AliZe198/simple-skill-manager/issues"
  },
  "type": "module",
  "bin": {
    "simple-skill-manager": "bin/cli.mjs"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "public",
    "scripts",
    "next.config.mjs",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "next build",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "better-sqlite3": "^12.11.1",
    "classnames": "^2.5.1",
    "next": "15.5.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
